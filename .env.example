# --- Database (Neon, Supabase of eigen Postgres) ---
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# --- Sessies ---
# Genereer met: openssl rand -base64 32
AUTH_SECRET=""

# Sleutel voor persoonsgegevens (IBAN, kopie ID, loonheffingsformulier). 32 bytes als base64:
#   openssl rand -base64 32
# Kwijt is kwijt: zonder deze sleutel zijn opgeslagen documenten niet meer te lezen.
GEGEVENS_SLEUTEL=""

# Basis-URL van de app, gebruikt in inloglinks
APP_URL="http://localhost:3000"

# --- E-mail (Resend) voor de inloglinks ---
RESEND_API_KEY=""
MAIL_FROM="James Robinson Wallet <wallet@jamesrobinson.nl>"

# --- ClickUp ---
CLICKUP_API_TOKEN=""
CLICKUP_TEAM_ID="2491910"
# CRM-lijsten (zie README voor hoe je deze vindt)
CLICKUP_LIST_ABONNEMENTEN="901503907238"
CLICKUP_LIST_BEDRIJVEN="901503849821"

# Beveiligt de sync-endpoint tegen misbruik. openssl rand -hex 32
SYNC_SECRET=""

# Beveiligt de dagelijkse abonnementsrun. openssl rand -hex 32
# Zonder dit geheim weigert /api/cron/billing elke aanvraag.
CRON_SECRET=""

# Beveiligt het sollicitatie-endpoint. openssl rand -hex 32
# Dit geheim zet je in de webhook-URL van het Elementor-formulier op
# jamesrobinson.nl, als ?sleutel=<waarde>. Het komt nooit in de HTML van de
# site terecht: de bezoeker post naar WordPress, WordPress post naar ons.
# Zonder dit geheim weigert /api/sollicitatie elke aanvraag.
SOLLICITATIE_SECRET=""

# De enige host waarvan een cv opgehaald mag worden. Leeg laten betekent:
# geen cv's ophalen. Dit is een beveiligingsinstelling, geen gemak - een
# server die elk adres ophaalt kan gebruikt worden om te praten met dingen
# die alleen die server kan bereiken.
SOLLICITATIE_BESTAND_HOST="jamesrobinson.nl"

# E-mailadressen die beheerrechten krijgen, komma-gescheiden
ADMIN_EMAILS="jim@jamesrobinson.nl"

# De sleutel voor de Claude-API: feedback van een klant verwerken in een
# campagnebriefing. Aan te maken in de Claude Console (console.anthropic.com),
# onder API keys. Alleen in Netlify zetten, nooit in de code of in een chat.
ANTHROPIC_API_KEY=""

# --- Performance: Google Ads en Meta Ads ---
# Google Ads leest mee via een verbonden Google-account (Beheer → Koppelingen)
# dat bij ons MCC kan. Daarnaast wil Google twee vaste gegevens van het MCC:
# De developer token: Google Ads → inloggen op het MCC → Beheer (Admin) →
# API Center. Op Test-niveau leest Google alleen testaccounts; vraag daar
# Basic-toegang aan voordat klanten cijfers krijgen.
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Het klant-ID van het MCC zelf (rechtsboven in Google Ads), zonder streepjes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# Meta Ads gaat zonder inlogscherm, met een systeemgebruiker van onze Business
# Manager: Business Manager → Instellingen → Gebruikers → Systeemgebruikers →
# Token genereren, met de app van James Robinson en het recht ads_read. Geef
# de systeemgebruiker daarna leesrecht op elk advertentieaccount van een klant.
META_ACCESS_TOKEN=""
