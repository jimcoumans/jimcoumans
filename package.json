{
  "name": "jr-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "James Robinson Wallet - budgetportaal voor klanten",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "sync:clickup": "tsx --env-file-if-exists=.env.local src/lib/clickup/run-sync.ts",
    "test": "tsx --test --env-file-if-exists=.env.local 'src/**/__tests__/*.test.ts'",
    "login:link": "tsx --env-file-if-exists=.env.local src/db/login-link.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "jose": "6.1.0",
    "next": "16.3.4",
    "postgres": "3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.5",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
