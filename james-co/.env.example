# James & Co. — omgevingsvariabelen. Kopieer naar .env.local en vul in.
# Sleutels horen alleen hier (of in de secrets van je hostingplatform), nooit in git of in app_settings.

# --- VERPLICHT ---------------------------------------------------------------
# Inlogrol van de app. Moet een gewone rol zijn (geen eigenaar, geen superuser,
# geen BYPASSRLS). `npm run db:migrate` maakt hem aan als hij niet bestaat en
# geeft hem lidmaatschap van jc_app.
DATABASE_URL="postgres://jc_app_login:KIES-EEN-WACHTWOORD@localhost:5444/jamesco"
# Eigenaar van het schema; alleen voor migraties, demo-seed en staff:add.
# Nooit in de draaiende app gebruiken.
DATABASE_ADMIN_URL="postgres://postgres@localhost:5444/jamesco"
# Canonieke URL (inloglinks, uitnodigingslinks). Lokaal localhost; productie:
# het geregistreerde domein. Gebruik geen niet-geverifieerd James-domein.
APP_URL="http://localhost:3100"
# development | demo | test | production
#   demo: banner "fictieve gegevens", demo-seed toegestaan, niet indexeren.
#   production: MFA voor staff altijd verplicht, nooit dev-mailbox.
APP_ENV="development"
# Minimaal 32 tekens. Genereer met: openssl rand -base64 32
SESSION_SECRET=""

# --- OPTIONEEL ---------------------------------------------------------------
# E-mail (Resend). Zonder deze twee: in productie worden geen mails verstuurd
# (status not_configured); buiten productie gaan mails naar .dev-mailbox/mail.jsonl.
RESEND_API_KEY=""
MAIL_FROM="James & Co. <service@example.com>"
# Alleen buiten productie uit te zetten voor lokaal werk. Standaard: verplicht.
STAFF_MFA_REQUIRED="true"
# Grootte van de databasepool per serverinstantie.
DATABASE_POOL_MAX="10"

# --- P1 (nog niet gebouwd; laat leeg) -----------------------------------------
# WHATSAPP_CLOUD_API_TOKEN=""   # officiële Cloud API, na Meta-verificatie
# PAYMENT_PROVIDER_KEY=""       # hosted checkout + ondertekende webhooks
# ANTHROPIC_API_KEY=""          # AI-concepten, altijd met menselijke goedkeuring
