{
  "name": "james-co",
  "version": "0.1.0",
  "private": true,
  "description": "James & Co. - persoonlijke concierge en The James Society (V1)",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "staff:add": "tsx --env-file-if-exists=.env.local scripts/staff-add.ts",
    "test": "tsx --env-file-if-exists=.env.test --test --test-concurrency=1 'tests/**/*.test.ts'",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "next": "16.3.4",
    "postgres": "3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
